<?xml version="1.0" encoding="UTF-8"?>

<rendertheme
    xmlns="http://mapsforge.org/renderTheme"
    version="6"
    map-background="#9FD4E5">

    <!-- ========================= -->
    <!-- البحر -->
    <!-- ========================= -->

    <rule e="way" k="natural" v="water">
        <area fill="#9FD4E5"/>
    </rule>

    <rule e="way" k="natural" v="sea">
        <area fill="#9FD4E5"/>
    </rule>

    <rule e="way" k="natural" v="coastline">
        <line
            stroke="#4C9DB8"
            stroke-width="0.7"/>
    </rule>

    <rule e="way" k="water" v="*">
        <area fill="#9FD4E5"/>
    </rule>


    <!-- ========================= -->
    <!-- اليابسة -->
    <!-- ========================= -->

    <rule e="way" k="natural" v="land">
        <area fill="#E8E3D8"/>
    </rule>

    <rule e="way" k="landuse" v="forest">
        <area fill="#C9D8B5"/>
    </rule>

    <rule e="way" k="natural" v="wood">
        <area fill="#C9D8B5"/>
    </rule>

    <rule e="way" k="natural" v="forest">
        <area fill="#C9D8B5"/>
    </rule>

    <rule e="way" k="natural" v="scrub">
        <area fill="#D8DFC4"/>
    </rule>

    <rule e="way" k="natural" v="grassland">
        <area fill="#DDE5C8"/>
    </rule>

    <rule e="way" k="natural" v="sand">
        <area fill="#E8D6A8"/>
    </rule>

    <rule e="way" k="natural" v="bare_rock">
        <area fill="#CFC8B8"/>
    </rule>


    <!-- ========================= -->
    <!-- الأنهار والمياه الداخلية -->
    <!-- ========================= -->

    <rule e="way" k="waterway" v="river|canal">
        <line
            stroke="#78BDD6"
            stroke-width="1.2"/>
    </rule>

    <rule e="way" k="waterway" v="stream|ditch">
        <line
            stroke="#8BC9DC"
            stroke-width="0.6"/>
    </rule>


    <!-- ========================= -->
    <!-- التقسيم الإداري البري -->
    <!-- ========================= -->

    <rule e="way" k="boundary" v="administrative">

        <rule e="way" k="admin_level" v="2|4|6|8">

            <line
                stroke="#7D526C"
                stroke-width="0.8"
                stroke-dasharray="6,3"/>

        </rule>

    </rule>


    <!-- ========================= -->
    <!-- الطرق الرئيسية -->
    <!-- ========================= -->

    <rule e="way" k="highway" v="motorway">
        <line
            stroke="#D96F32"
            stroke-width="2.4"/>
    </rule>

    <rule e="way" k="highway" v="trunk">
        <line
            stroke="#E07A35"
            stroke-width="2"/>
    </rule>

    <rule e="way" k="highway" v="primary">
        <line
            stroke="#E5A23C"
            stroke-width="1.7"/>
    </rule>

    <rule e="way" k="highway" v="secondary">
        <line
            stroke="#E8BD59"
            stroke-width="1.4"/>
    </rule>

    <rule e="way" k="highway" v="tertiary">

        <line
            stroke="#FFFFFF"
            stroke-width="1.2"/>

        <line
            stroke="#AAA59C"
            stroke-width="0.25"/>

    </rule>

    <rule e="way" k="highway" v="residential|unclassified">

        <line
            stroke="#FFFFFF"
            stroke-width="0.9"/>

        <line
            stroke="#AAA7A0"
            stroke-width="0.18"/>

    </rule>

    <rule e="way" k="highway" v="service">
        <line
            stroke="#C2BEB6"
            stroke-width="0.35"/>
    </rule>


    <!-- ========================= -->
    <!-- المدن -->
    <!-- ========================= -->

    <rule e="node" k="place" v="city">

        <circle
            radius="3.2"
            fill="#555555"/>

        <caption
            k="name"
            font-size="14"
            font-style="bold"
            fill="#222222"
            stroke="#FFFFFF"
            stroke-width="2"
            priority="10"/>

    </rule>


    <!-- ========================= -->
    <!-- البلدات -->
    <!-- ========================= -->

    <rule e="node" k="place" v="town">

        <circle
            radius="2.5"
            fill="#666666"/>

        <caption
            k="name"
            font-size="12"
            font-style="bold"
            fill="#333333"
            stroke="#FFFFFF"
            stroke-width="2"
            priority="8"/>

    </rule>


    <!-- ========================= -->
    <!-- القرى -->
    <!-- ========================= -->

    <rule e="node" k="place" v="village">

        <circle
            radius="1.8"
            fill="#777777"/>

        <caption
            k="name"
            font-size="10"
            fill="#444444"
            stroke="#FFFFFF"
            stroke-width="1.5"
            priority="6"/>

    </rule>


    <!-- ========================= -->
    <!-- أسماء الدول -->
    <!-- ========================= -->

    <rule e="node" k="place" v="country">

        <caption
            k="name"
            font-size="16"
            font-style="bold"
            fill="#222222"
            stroke="#FFFFFF"
            stroke-width="2.5"
            priority="20"/>

    </rule>


    <!-- ========================= -->
    <!-- المحافظات والمناطق -->
    <!-- ========================= -->

    <rule
        e="node"
        k="place"
        v="state|province|region">

        <caption
            k="name"
            font-size="11"
            fill="#444444"
            stroke="#FFFFFF"
            stroke-width="2"
            priority="10"/>

    </rule>


    <!-- ========================= -->
    <!-- أسماء الأنهار -->
    <!-- ========================= -->

    <rule
        e="way"
        k="waterway"
        v="river|canal">

        <pathText
            k="name"
            font-size="9"
            fill="#4F91A8"
            stroke="#FFFFFF"
            stroke-width="1"/>

    </rule>


    <!-- ========================= -->
    <!-- أسماء الطرق -->
    <!-- ========================= -->

    <rule
        e="way"
        k="highway"
        v="motorway|trunk|primary|secondary|tertiary"
        zoom-min="11">

        <pathText
            k="name"
            font-size="9"
            fill="#555555"
            stroke="#FFFFFF"
            stroke-width="1.5"/>

    </rule>

</rendertheme>
