<?xml version="1.0" encoding="UTF-8"?>  
<!--  
  AlHaswa Magellan - RenderTheme موحّد  
  متوافق مع Mapsforge 0.25.0 (RenderTheme v6)  
    
  يعرض:  البحر، اليابسة، السواحل، حدود الدول البرية،  
          أسماء الدول، الطرق، المدن، القرى، الأنهار  
  لا يعرض: الحدود البحرية، المياه الإقليمية  
-->  
<rendertheme  
    xmlns="http://mapsforge.org/renderTheme"  
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd"  
    version="6"  
    map-background="#9FD4E5"  
    map-background-outside="#9FD4E5">  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  البحر واليابسة                                   -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <!-- البحر: مضلعات صريحة -->  
    <rule e="way" k="natural" v="sea">  
        <area fill="#9FD4E5"/>  
    </rule>  
  
    <!-- اليابسة: nosea — الوسم الأهم! -->  
    <!-- بدون هذه القاعدة تظهر اليابسة بلون الخلفية (أزرق) -->  
    <rule e="way" k="natural" v="nosea">  
        <area fill="#F2EFE8"/>  
    </rule>  
  
    <!-- اليابسة: وسم land (إضافي) -->  
    <rule e="way" k="natural" v="land">  
        <area fill="#F2EFE8"/>  
    </rule>  
  
    <!-- المسطحات المائية الداخلية (بحيرات) -->  
    <rule e="way" k="natural" v="water">  
        <area fill="#9FD4E5"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  السواحل                                          -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="way" k="natural" v="coastline">  
        <line stroke="#4C9DB8" stroke-width="0.8"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  الغابات والأراضي                                 -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="way" k="landuse" v="forest">  
        <area fill="#C9D8B5"/>  
    </rule>  
  
    <rule e="way" k="natural" v="wood|forest">  
        <area fill="#C9D8B5"/>  
    </rule>  
  
    <rule e="way" k="natural" v="scrub">  
        <area fill="#D8DFC4"/>  
    </rule>  
  
    <rule e="way" k="natural" v="grassland">  
        <area fill="#DDE5C8"/>  
    </rule>  
  
    <rule e="way" k="natural" v="sand">  
        <area fill="#E8D6A8"/>  
    </rule>  
  
    <rule e="way" k="natural" v="bare_rock">  
        <area fill="#CFC8B8"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  حدود الدول البرية فقط                            -->  
    <!--  (لا نعرض boundary=maritime أو maritime=yes)     -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <!-- حدود الدول: admin_level=2 -->  
    <rule e="way" k="boundary" v="administrative">  
        <rule e="way" k="admin_level" v="2">  
            <line stroke="#7D526C" stroke-width="1.0" stroke-dasharray="8,4"/>  
        </rule>  
    </rule>  
  
    <!-- حدود المحافظات: admin_level=4 -->  
    <rule e="way" k="boundary" v="administrative">  
        <rule e="way" k="admin_level" v="4">  
            <line stroke="#9D728C" stroke-width="0.6" stroke-dasharray="5,3"/>  
        </rule>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  أسماء الدول (تظهر من مستوى تكبير 3)             -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="node" k="place" v="country">  
        <caption  
            k="name"  
            font-size="16"  
            font-style="bold"  
            fill="#222222"  
            stroke="#FFFFFF"  
            stroke-width="2.5"  
            priority="30"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  أسماء المحافظات والمناطق                        -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="node" k="place" v="state|province|region">  
        <caption  
            k="name"  
            font-size="12"  
            fill="#444444"  
            stroke="#FFFFFF"  
            stroke-width="2"  
            priority="20"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  الأنهار والمجاري المائية                         -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="way" k="waterway" v="river|canal">  
        <line stroke="#78BDD6" stroke-width="1.5"/>  
        <pathText  
            k="name"  
            font-size="9"  
            fill="#4F91A8"  
            stroke="#FFFFFF"  
            stroke-width="1"  
            zoom-min="11"/>  
    </rule>  
  
    <rule e="way" k="waterway" v="stream|ditch">  
        <line stroke="#8BC9DC" stroke-width="0.6"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  المدن الكبرى (تظهر من مستوى تكبير 6)            -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="node" k="place" v="city">  
        <circle radius="3" fill="#555555"/>  
        <caption  
            k="name"  
            font-size="14"  
            font-style="bold"  
            fill="#222222"  
            stroke="#FFFFFF"  
            stroke-width="2"  
            priority="10"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  البلدات                                          -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="node" k="place" v="town">  
        <circle radius="2.2" fill="#666666"/>  
        <caption  
            k="name"  
            font-size="12"  
            font-style="bold"  
            fill="#333333"  
            stroke="#FFFFFF"  
            stroke-width="2"  
            priority="8"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  القرى (تظهر من مستوى تكبير 9)                    -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <rule e="node" k="place" v="village">  
        <circle radius="1.5" fill="#777777"/>  
        <caption  
            k="name"  
            font-size="10"  
            fill="#444444"  
            stroke="#FFFFFF"  
            stroke-width="1.5"  
            priority="6"/>  
    </rule>  
  
    <!-- ================================================= -->  
    <!--                                                   -->  
    <!--  الطرق                                            -->  
    <!--                                                   -->  
    <!-- ================================================= -->  
  
    <!-- طريق سريع: motorway -->  
    <rule e="way" k="highway" v="motorway" zoom-min="6">  
        <line stroke="#D96F32" stroke-width="2.5"/>  
        <pathText  
            k="name"  
            font-size="9"  
            fill="#555555"  
            stroke="#FFFFFF"  
            stroke-width="1.5"  
            zoom-min="12"/>  
    </rule>  
  
    <!-- طريق رئيسي: trunk -->  
    <rule e="way" k="highway" v="trunk" zoom-min="6">  
        <line stroke="#E07A35" stroke-width="2.0"/>  
    </rule>  
  
    <!-- طريق أولي: primary -->  
    <rule e="way" k="highway" v="primary" zoom-min="8">  
        <line stroke="#E5A23C" stroke-width="1.8"/>  
    </rule>  
  
    <!-- طريق ثانوي: secondary -->  
    <rule e="way" k="highway" v="secondary" zoom-min="9">  
        <line stroke="#E8BD59" stroke-width="1.5"/>  
    </rule>  
  
    <!-- طريق ثالثي: tertiary -->  
    <rule e="way" k="highway" v="tertiary" zoom-min="10">  
        <line stroke="#FFFFFF" stroke-width="1.3"/>  
        <line stroke="#AAA59C" stroke-width="0.3"/>  
    </rule>  
  
    <!-- طريق سكني: residential / unclassified -->  
    <rule e="way" k="highway" v="residential|unclassified" zoom-min="12">  
        <line stroke="#FFFFFF" stroke-width="1.0"/>  
        <line stroke="#AAA7A0" stroke-width="0.2"/>  
    </rule>  
  
    <!-- طريق خدمي: service -->  
    <rule e="way" k="highway" v="service" zoom-min="14">  
        <line stroke="#C2BEB6" stroke-width="0.4"/>  
    </rule>  
  
    <!-- ممر / مسار مشاة -->  
    <rule e="way" k="highway" v="track|path|footway" zoom-min="13">  
        <line stroke="#B5AE8E" stroke-width="0.3" stroke-dasharray="4,3"/>  
    </rule>  
  
</rendertheme>  
